# ================= CẤU HÌNH TELEGRAM =================
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Chuỗi bí mật bảo vệ endpoint webhook (tự đặt ngẫu nhiên, dùng khi triển khai Vercel/Render)
TELEGRAM_WEBHOOK_SECRET=
# Chuỗi bí mật riêng cho /api/cron (bỏ trống sẽ dùng chung TELEGRAM_WEBHOOK_SECRET)
CRON_SECRET=

# ================= ĐỒNG BỘ GITHUB REPOSITORY VARIABLES (TUỲ CHỌN) =================
# Dùng cho webhook /gold_set cập nhật trực tiếp GOLD_TARGET_PRICE lên GitHub Actions
# Tạo Fine-grained PAT với quyền: Repository permissions -> Variables: Read and write
GITHUB_TOKEN=
GITHUB_REPOSITORY=ndtruongg/telegram-bot

# ================= CẤU HÌNH HỆ THỐNG =================
LOG_LEVEL=INFO
STATE_FILE=.bot_state.json

# ================= TÍNH NĂNG: GIÁ VÀNG SJC =================
GOLD_ENABLED=true
GOLD_URL=https://webgia.com/gia-vang/sjc/
GOLD_TARGET_PRICE=13500000
GOLD_CHECK_INTERVAL=3600

# ================= TÍNH NĂNG: TÓM TẮT TIN TỨC BUỔI SÁNG =================
NEWS_ENABLED=true
# Danh sách nguồn RSS ngăn cách bởi dấu phẩy
NEWS_RSS_URLS=https://vnexpress.net/rss/tin-noi-bat.rss,https://tuoitre.vn/rss/tin-moi-nhat.rss
# Giờ gửi bản tin hằng ngày (mặc định 07:00 giờ Việt Nam)
NEWS_SEND_HOUR=7
NEWS_SEND_MINUTE=0
NEWS_TIMEZONE=Asia/Ho_Chi_Minh
NEWS_MAX_ARTICLES=20
NEWS_MAX_HIGHLIGHTS=12
NEWS_CHECK_INTERVAL=60
# Gemini API Key (miễn phí tại https://aistudio.google.com/apikey)
# Nếu để trống, bot sẽ tự động chuyển sang tóm tắt nhanh trực tiếp từ RSS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ================= TÍNH NĂNG: NHẮC VIỆC & ĐẾM NGƯỢC SỰ KIỆN =================
REMINDERS_ENABLED=true
# Giờ gửi thông báo nhắc việc & đếm ngược hằng ngày (mặc định 07:00 giờ Việt Nam)
REMINDERS_SEND_HOUR=7
REMINDERS_SEND_MINUTE=0
REMINDERS_TIMEZONE=Asia/Ho_Chi_Minh
# Các mốc nhắc trước sự kiện (số ngày, ngăn cách bởi dấu phẩy; luôn bao gồm đúng ngày = 0)
REMINDERS_LEAD_DAYS=7,3,1,0
REMINDERS_CHECK_INTERVAL=60
# Dữ liệu JSON nhắc việc (tự động đồng bộ qua GitHub Variable REMINDERS_DATA khi dùng lệnh /remind_add)
REMINDERS_DATA=

# ================= TÍNH NĂNG: TỪ VỰNG TIẾNG ANH MỖI NGÀY =================
VOCAB_ENABLED=true
# Chủ đề mặc định: it | communication | ielts | mixed (luân phiên 3 chủ đề)
VOCAB_TOPIC=mixed
# Số từ/cụm từ mỗi buổi (khuyến nghị 3–5, mặc định 4)
VOCAB_WORDS_PER_BATCH=4
# Các khung giờ gửi sáng/tối (HH:MM, ngăn cách bởi dấu phẩy; mặc định 08:00 và 20:00)
VOCAB_SEND_TIMES=08:00,20:00
VOCAB_TIMEZONE=Asia/Ho_Chi_Minh
VOCAB_CHECK_INTERVAL=60
# Số từ tối đa lưu trong lịch sử để tránh gửi trùng lặp
VOCAB_MAX_HISTORY=300
# Lịch sử từ vựng JSON (tự động đồng bộ qua GitHub Variable VOCAB_HISTORY khi dùng webhook/cron)
VOCAB_HISTORY=
